{
	"schemaVersion": 1,
	"id": "chatcraft",
	"version": "${version}",
	"name": "ChatCraft",
	"description": "Lets Twitch and YouTube chat directly control the Minecraft client.",
	"authors": [
		"tenkayro"
	],
	"icon": "assets/chatcraft/icon.png",
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.tenkayro.chatcraft.ChatCraftClient"
		],
		"modmenu": [
			"de.tenkayro.chatcraft.config.ChatCraftModMenu"
		]
	},
	"mixins": [
		"chatcraft.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"modmenu": ">=11.0.0"
	}
}
